# Copy this file to `.env` on the server (or set these variables in your
# hosting panel) and fill in the values. Never commit the real `.env` file.

# Must be False on the public server.
DJANGO_DEBUG=False

# Long random secret, different from the one on your computer. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Your domain(s), comma separated, without https://
DJANGO_ALLOWED_HOSTS=arcaniawiki.example.com

# The same domain(s) WITH https:// (needed to log in to the admin panel)
DJANGO_CSRF_TRUSTED_ORIGINS=https://arcaniawiki.example.com

# Address of the admin panel: https://<domain>/arcaniawikiadmin/
DJANGO_ADMIN_URL=arcaniawikiadmin

# Set to True when the hosting puts the site behind a proxy that handles HTTPS
# (most hosting panels, PythonAnywhere, Render, Railway, Cloudflare...).
DJANGO_BEHIND_PROXY=False

# Seconds browsers must use HTTPS only. Start with 3600; raise to 31536000
# once HTTPS is confirmed to work.
DJANGO_HSTS_SECONDS=3600

# Keep True unless a separate web server (nginx/Apache) serves /media/.
DJANGO_SERVE_MEDIA=True

# Admin login protection: failed attempts allowed, and lockout time in seconds.
DJANGO_ADMIN_LOGIN_MAX_FAILURES=5
DJANGO_ADMIN_LOGIN_LOCKOUT_SECONDS=900
